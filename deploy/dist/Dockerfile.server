# KK物联云 后端薄镜像（单阶段，COPY 预编译静态二进制）
# 构建上下文 = build.sh 组装的暂存目录（含 server 二进制 + configs/）
# 注意：不在客户机构建。本 Dockerfile 仅在构建机执行（docker buildx --load）。
FROM alpine:3.20
# ca-certificates：规则引擎 webhook 可配 https 出站；tzdata：保守保留（当前代码不依赖）
RUN apk add --no-cache ca-certificates tzdata && adduser -D -u 10001 app
WORKDIR /app
COPY server /app/server            # 预编译二进制（CGO_ENABLED=0 静态）
COPY configs /app/configs          # 默认配置；compose 挂载 config.prod.yaml 覆盖
# uploads/firmware 必须预存在且属主为 app：named volume 首次挂载会复制此目录的属主，
# 否则固件上传（ota.go 以 uid 10001 写 uploads/firmware）会 EPERM
RUN mkdir -p /app/uploads/firmware && chown -R app:app /app
USER app
EXPOSE 8080 9100
# exec 形式：Go 进程即 PID 1，直收 SIGTERM，配合 main.go 的优雅关闭（刷 telemetry buffer）
ENTRYPOINT ["/app/server"]
CMD ["-conf", "configs/config.yaml"]
